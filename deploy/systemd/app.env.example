# FlipBlog production environment file.
#
# Reference for Issue #34. Install to /etc/flipblog/app.env, owned root:flipblog,
# mode 0600. Values are production-safe examples; replace every secret and set
# real paths. Never commit a real app.env.

# Server bind. Behind Caddy the app binds loopback only.
PORT=3000
HOST=127.0.0.1

# Signing secret: >= 32 chars, random, not a known default.
# Generate:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=REPLACE_WITH_64_HEX_CHARS

# One TLS-terminating reverse proxy (Caddy) sits in front. It forwards
# X-Forwarded-For / X-Forwarded-Proto, so trust exactly that one hop.
TRUST_PROXY=1

# Seed admin (only used when the accounts table is empty).
ADMIN_USER=REPLACE_ME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# SQLite database and uploads live on the persistent data disk.
DB_PATH=/var/lib/flipblog/flipblog.db
UPLOADS_DIR=/var/lib/flipblog/uploads
# Built SPA + static assets, inside the active release (see deploy/README.md:
# the release dir is the built `server` package, so public/ sits at its root).
PUBLIC_DIR=/srv/flipblog/current/public

# Startup (pre-migration) backups + retention.
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=/var/lib/flipblog/backups
DB_BACKUP_RETENTION=5

# Offsite (disaster-recovery) backups to independent object storage.
BACKUP_OFFSITE_ENABLED=true
BACKUP_OFFSITE_DIR=/var/lib/flipblog/offsite-staging
BACKUP_OFFSITE_KEY=REPLACE_WITH_32_BYTE_AES_KEY
BACKUP_OFFSITE_RETENTION=5

# Graceful shutdown window (ms). systemd TimeoutStopSec must exceed this.
SHUTDOWN_GRACE_MS=10000

# Auth rate limiting (in-process; single replica).
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ENTRIES=10000
